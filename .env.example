# Copy to .env.local (never commit real values).

# Postgres connection string (local: see README; later Neon via Vercel Marketplace)
DATABASE_URL=postgres://hub:hub@localhost:5432/hub_dev

# Auth.js (NextAuth v4). Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Password for the fictitious demo users created by `npm run db:seed` (min 12 chars)
SEED_DEMO_PASSWORD=

# Integration tests (Vitest) run against this database when set
TEST_DATABASE_URL=postgres://hub:hub@localhost:5432/hub_test
